# ------------------------------------------------------------------
# TisStan — variables d'environnement
# Copiez ce fichier en `.env` puis remplissez les valeurs.
# SANS ces variables, l'app démarre en MODE DÉMO complet
# (données locales + IA simulée) : parfait pour tester dans Expo Go.
# ------------------------------------------------------------------

# Firebase (console.firebase.google.com → Paramètres du projet → Vos applications)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Gemini API (https://aistudio.google.com/apikey)
EXPO_PUBLIC_GEMINI_API_KEY=

# Emails des deux comptes (Firebase Authentication → créer ces utilisateurs)
EXPO_PUBLIC_STANNE_EMAIL=stanne@tisstan.app
EXPO_PUBLIC_TISSAM_EMAIL=tissam@tisstan.app
